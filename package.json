{
  "name": "@neabyte/byte-tokenizer",
  "description": "Encode text into deterministic byte IDs and special tokens",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "unbuild --minify",
    "clean": "rm -rf dist",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "keywords": [
    "byte-level",
    "byte-tokenizer",
    "chat-template",
    "decoding",
    "encoding",
    "language-model",
    "mit",
    "natural-language-processing",
    "nlp",
    "special-tokens",
    "string-processing",
    "text-decoding",
    "text-encoding",
    "text-processing",
    "tokenids",
    "tokenization",
    "tokenizer",
    "unicode",
    "utf-8",
    "vocabulary-free"
  ],
  "dependencies": {},
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "unbuild": "^3.6.1"
  },
  "author": {
    "name": "NeaByteLab",
    "email": "me@neabyte.com",
    "url": "https://github.com/NeaByteLab"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeaByteLab/Byte-Tokenizer.git"
  },
  "bugs": {
    "url": "https://github.com/NeaByteLab/Byte-Tokenizer/issues"
  },
  "homepage": "https://github.com/NeaByteLab/Byte-Tokenizer#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
